# Copy to .env and fill in real values. .env is gitignored; this file is not.
# This file exists so anyone cloning the repo knows which keys are required.
# Never put a real secret here.

# Server
PORT=3000
NODE_ENV=development

# Postgres — local container from docker-compose.yml, started with `npm run db:up`.
# Host port is 5433, not the default 5432, which another project already uses.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fullstack_dev?schema=public"

# Auth (stage 8) — generate with: openssl rand -base64 32
JWT_SECRET="replace-me"

# CORS (stage 10) — explicit origin, never "*" when sending credentials
CORS_ORIGIN="http://localhost:5173"
